// Este é o schema do Prisma para o BarberSaaS.
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// AUTH & BILLING
// =====================================================

// O usuário é sempre o DONO da barbearia.
// Clientes finais não têm conta (são Customer).
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // null se entrou via Google OAuth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relações 1:1
  barbershop   Barbershop?
  subscription Subscription?

  // Relações Auth.js (serão preenchidas no Módulo 3)
  accounts Account[]
  sessions Session[]
}

// Tabelas padrão do Auth.js v5 (não mexer)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Controle de assinatura Stripe do dono da barbearia
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  TRIALING     // período de teste grátis
  ACTIVE       // assinatura paga e em dia
  PAST_DUE     // cartão falhou, tentando de novo
  CANCELED     // cancelada
  INCOMPLETE   // pagamento inicial falhou
}

// =====================================================
// CORE BUSINESS
// =====================================================

// A barbearia em si. Este é o "tenant" do nosso sistema.
// Cada User é dono de 1 Barbershop.
model Barbershop {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  slug        String   @unique // URL pública: /b/barbearia-do-eren
  description String?
  phone       String?
  address     String?
  logoUrl     String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      Service[]
  barbers       Barber[]
  businessHours BusinessHours[]
  appointments  Appointment[]
  customers     Customer[]

  @@index([slug])
}

// Serviço oferecido (corte, barba, sobrancelha, etc.)
model Service {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  description  String?
  priceInCents Int      // R$ 50,00 = 5000 (evita bug de float)
  durationMin  Int      // duração em minutos (30, 45, 60...)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([barbershopId])
}

// Barbeiro (funcionário). Não tem login — só é gerenciado pelo dono.
model Barber {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  bio          String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([barbershopId])
}

// Horário de funcionamento da barbearia (1 registro por dia da semana)
model BusinessHours {
  id           String   @id @default(cuid())
  barbershopId String
  dayOfWeek    Int      // 0 = domingo, 1 = segunda, ..., 6 = sábado
  openTime     String   // "09:00" formato HH:mm
  closeTime    String   // "19:00"
  isClosed     Boolean  @default(false) // true = fechado nesse dia

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek])
}

// Cliente final. NÃO tem login. Criado automaticamente no fluxo de agendamento.
// Identificado por telefone dentro da barbearia (mesmo telefone em 2 barbearias = 2 Customers distintos).
model Customer {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  phone        String
  email        String?
  notes        String?  // anotações do barbeiro (ex: "alérgico a X")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([barbershopId, phone])
  @@index([barbershopId])
}

// Agendamento. Amarra todas as peças.
model Appointment {
  id           String            @id @default(cuid())
  barbershopId String
  customerId   String
  serviceId    String
  barberId     String
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(CONFIRMED)
  notes        String?
  priceInCents Int               // snapshot do preço no momento do agendamento
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  barber     Barber     @relation(fields: [barberId], references: [id], onDelete: Restrict)

  @@index([barbershopId])
  @@index([barberId, startTime])   // pra query de "horários do barbeiro X no dia Y"
  @@index([startTime])
}

enum AppointmentStatus {
  PENDING    // agendado mas pagamento ainda não confirmado (se tiver pagamento online)
  CONFIRMED  // confirmado, esperando acontecer
  COMPLETED  // aconteceu, foi feito
  CANCELLED  // cancelado (por cliente ou barbeiro)
  NO_SHOW    // cliente não apareceu (métrica importante)
}
// =====================================================
// SECURITY
// =====================================================

// Rate limiting de endpoints publicos (ex: agendamento publico).
// Armazena timestamps de tentativas por chave (ex: "booking:<ip>").
// Cleanup oportunistico feito no codigo da aplicacao.
model RateLimit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}